{
  "actorSpecification": 1,
  "name": "ashby-job-scraper",
  "title": "Ashby Job Scraper & API",
  "description": "Scrape Ashby ATS jobs via API with team filtering. Pull live roles from Buffer, Zapier, RevenueCat and more. Built for job boards and AI agents.",
  "version": "1.3.0",
  "license": "MIT",
  "meta": {
    "templateId": "node-basic"
  },
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "input": "INPUT_SCHEMA.json",
  "output": "OUTPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Ashby Jobs Dataset",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "companyName",
              "title",
              "department",
              "locations",
              "type",
              "compensationSummary",
              "locationRequirements",
              "publishedAt",
              "postingUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "companyName": {
                "label": "Company",
                "format": "text"
              },
              "title": {
                "label": "Job Title",
                "format": "text"
              },
              "department": {
                "label": "Department",
                "format": "text"
              },
              "locations": {
                "label": "Locations",
                "format": "array"
              },
              "type": {
                "label": "Type",
                "format": "text"
              },
              "compensationSummary": {
                "label": "Compensation",
                "format": "text"
              },
              "locationRequirements": {
                "label": "Eligible Countries",
                "format": "array"
              },
              "publishedAt": {
                "label": "Published",
                "format": "date"
              },
              "postingUrl": {
                "label": "URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
